{
  "prettier-markdown": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./scripts/format-markdown.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}